/*
PROGRAM 1: To create a new process that executes a new program using
system calls fork(), execlp() and wait()
*/

#include <stdio.h>
#include <stdlib.h>
#include <sys/wait.h>
#include <unistd.h>

int main() {
    int pid;

    pid = fork();

    if (pid < 0) {
        printf("Fork failed\n");
        exit(1);
    }
    else if (pid == 0) {
        printf("\nNow in child process and its output is:\n");

        execlp("ls", "ls", (char *)NULL);

        perror("execlp failed");
        exit(1);
    }
    else {
        printf("\nChild process created successfully\n");
        printf("\nChild process ID is %d\n", pid);

        wait(NULL);

        printf("\nReturned to parent process, now ready to exit\n\n");
    }

    return 0;
}

/*
PROGRAM 2: To display PID and PPID using system calls
getpid() and getppid()
*/

#include <stdio.h>
#include <sys/wait.h>
#include <unistd.h>

int main() {
    pid_t pid = fork();

    if (pid < 0) {
        perror("Fork failed");
        return 1;
    }
    else if (pid == 0) {
        printf("Child process -> PID: %d, PPID: %d\n",
               getpid(), getppid());
    }
    else {
        wait(NULL);

        printf("Parent process -> PID: %d, PPID: %d\n",
               getpid(), getppid());
    }

    return 0;
}


/*
PROGRAM 3: Program using I/O system calls open(), read() and write()
to copy contents of one file to another file.
*/

#include <fcntl.h>
#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>

#define BUF_SIZE 1024

int main() {
    int src_fd, dest_fd;
    ssize_t bytes_read;
    char buffer[BUF_SIZE];
    char source[100], destination[100];

    printf("Enter source file name: ");
    scanf("%99s", source);

    printf("Enter destination file name: ");
    scanf("%99s", destination);

    src_fd = open(source, O_RDONLY);

    if (src_fd == -1) {
        perror("Error opening source file");
        exit(1);
    }

    dest_fd = open(destination, O_WRONLY | O_CREAT | O_TRUNC, 0644);

    if (dest_fd == -1) {
        perror("Error opening destination file");
        close(src_fd);
        exit(1);
    }

    while ((bytes_read = read(src_fd, buffer, BUF_SIZE)) > 0) {
        if (write(dest_fd, buffer, bytes_read) != bytes_read) {
            perror("Error writing to destination file");
            close(src_fd);
            close(dest_fd);
            exit(1);
        }
    }

    if (bytes_read == -1) {
        perror("Error reading source file");
        close(src_fd);
        close(dest_fd);
        exit(1);
    }

    printf("\nFile copied successfully!\n");

    close(src_fd);
    close(dest_fd);

    return 0;
}

/*
PROGRAM 4: C program to implement a multithreaded program using pthreads.
*/

#include <pthread.h>
#include <stdio.h>

void *print_message(void *arg) {
    char *message = (char *)arg;
    int i;

    for (i = 0; i < 3; i++) {
        printf("Thread [%s]: iteration %d\n", message, i + 1);
    }

    pthread_exit(NULL);
}

int main() {
    pthread_t t1, t2;

    pthread_create(&t1, NULL, print_message, (void *)"Thread-1");
    pthread_create(&t2, NULL, print_message, (void *)"Thread-2");

    pthread_join(t1, NULL);
    pthread_join(t2, NULL);

    printf("\nBoth threads have finished execution.\n");

    return 0;
}

#include <stdio.h>

void display(int n, int p[], int bt[], int wt[], int tat[]) {
  float aw = 0, at = 0;

  printf("\nP\tBT\tWT\tTAT\n");

  for (int i = 0; i < n; i++) {
    printf("P%d\t%d\t%d\t%d\n", p[i], bt[i], wt[i], tat[i]);
    aw += wt[i];
    at += tat[i];
  }

  printf("\nAverage WT  = %.2f", aw / n);
  printf("\nAverage TAT = %.2f\n", at / n);
}

void fcfs(int n, int p[], int bt[]) {
  int wt[n], tat[n];

  wt[0] = 0;

  for (int i = 1; i < n; i++)
    wt[i] = wt[i - 1] + bt[i - 1];

  for (int i = 0; i < n; i++)
    tat[i] = wt[i] + bt[i];

  display(n, p, bt, wt, tat);
}

void sort(int n, int p[], int bt[], int pr[], int type) {
  int t;

  for (int i = 0; i < n - 1; i++)
    for (int j = i + 1; j < n; j++)
      if ((type == 1 && bt[i] > bt[j]) || (type == 2 && pr[i] > pr[j])) {
        t = bt[i];
        bt[i] = bt[j];
        bt[j] = t;

        t = p[i];
        p[i] = p[j];
        p[j] = t;

        t = pr[i];
        pr[i] = pr[j];
        pr[j] = t;
      }
}

void rr(int n, int p[], int bt[], int q) {
  int rem[n], wt[n], tat[n], time = 0, done = 0;

  for (int i = 0; i < n; i++)
    rem[i] = bt[i];

  while (done < n) {
    for (int i = 0; i < n; i++) {
      if (rem[i] > 0) {
        if (rem[i] > q) {
          time += q;
          rem[i] -= q;
        } else {
          time += rem[i];
          wt[i] = time - bt[i];
          tat[i] = time;
          rem[i] = 0;
          done++;
        }
      }
    }
  }

  display(n, p, bt, wt, tat);
}

