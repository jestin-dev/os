/*
EXPERIMENT 5: CPU Scheduling Algorithms
FCFS, SJF, Priority Scheduling and Round Robin

Aim: To simulate FCFS, SJF, Priority and Round Robin
CPU scheduling algorithms.

Assumption: All processes arrive at time 0.
Lower priority number means higher priority.
*/

#include <stdio.h>

// Structure to store process details
struct Process {
    int pid, bt, wt, tat, pr;
};

// ALGORITHM 1: First-Come, First-Served (FCFS)
void findFCFS(struct Process p[], int n) {
    int i;

    // First process does not wait
    p[0].wt = 0;

    // Calculate waiting time
    for (i = 1; i < n; i++)
        p[i].wt = p[i - 1].wt + p[i - 1].bt;

    // Calculate turnaround time
    for (i = 0; i < n; i++)
        p[i].tat = p[i].wt + p[i].bt;
}

// ALGORITHM 2: Shortest Job First (SJF) - Non-preemptive
void findSJF(struct Process p[], int n) {
    struct Process temp;
    int i, j;

    // Sort processes by burst time in ascending order
    for (i = 0; i < n - 1; i++) {
        for (j = 0; j < n - i - 1; j++) {
            if (p[j].bt > p[j + 1].bt) {
                temp = p[j];
                p[j] = p[j + 1];
                p[j + 1] = temp;
            }
        }
    }

    // Calculate waiting and turnaround times
    findFCFS(p, n);
}

// ALGORITHM 3: Priority Scheduling
// Lower priority number means higher priority
void findPriority(struct Process p[], int n) {
    struct Process temp;
    int i, j;

    // Sort processes by priority in ascending order
    for (i = 0; i < n - 1; i++) {
        for (j = 0; j < n - i - 1; j++) {
            if (p[j].pr > p[j + 1].pr) {
                temp = p[j];
                p[j] = p[j + 1];
                p[j + 1] = temp;
            }
        }
    }

    // Calculate waiting and turnaround times
    findFCFS(p, n);
}

// ALGORITHM 4: Round Robin (RR) using Time Quantum
void findRoundRobin(struct Process p[], int n, int quantum) {
    int rem_bt[20];
    int t = 0, i, done;

    // Initialize remaining burst time and waiting time
    for (i = 0; i < n; i++) {
        rem_bt[i] = p[i].bt;
        p[i].wt = 0;
    }

    // Execute processes in cyclic order
    do {
        done = 1;

        for (i = 0; i < n; i++) {
            if (rem_bt[i] > 0) {
                done = 0;

                // Process needs more time than the quantum
                if (rem_bt[i] > quantum) {
                    t += quantum;
                    rem_bt[i] -= quantum;
                }
                // Process finishes within the quantum
                else {
                    t += rem_bt[i];
                    p[i].wt = t - p[i].bt;
                    rem_bt[i] = 0;
                }
            }
        }
    } while (!done);

    // Calculate turnaround time
    for (i = 0; i < n; i++)
        p[i].tat = p[i].wt + p[i].bt;
}

// FUNCTION: Display results and calculate average times
void printResult(struct Process p[], int n) {
    float total_wt = 0, total_tat = 0;
    int i;

    printf("\nPID\tBurst\tWait\tTurnaround\n");

    for (i = 0; i < n; i++) {
        printf("P%d\t%d\t%d\t%d\n",
               p[i].pid, p[i].bt, p[i].wt, p[i].tat);

        total_wt += p[i].wt;
        total_tat += p[i].tat;
    }

    printf("Average Waiting Time    : %.2f\n",
           total_wt / n);

    printf("Average Turnaround Time : %.2f\n",
           total_tat / n);
}

// MAIN FUNCTION: Accept input and select the algorithm
int main() {
    int n, choice, quantum, i;
    struct Process p[20];

    // Read number of processes
    printf("Enter number of processes: ");
    scanf("%d", &n);

    if (n < 1 || n > 20) {
        printf("Number of processes must be between 1 and 20.\n");
        return 1;
    }

    // Read burst time and priority for each process
    for (i = 0; i < n; i++) {
        p[i].pid = i + 1;

        printf("Enter burst time for P%d: ", i + 1);
        scanf("%d", &p[i].bt);

        printf("Enter priority for P%d (lower = higher priority): ",
               i + 1);
        scanf("%d", &p[i].pr);

        if (p[i].bt <= 0) {
            printf("Burst time must be positive.\n");
            return 1;
        }
    }

    // Display scheduling algorithm menu
    printf("\n1. FCFS\n");
    printf("2. SJF\n");
    printf("3. Priority\n");
    printf("4. Round Robin\n");
    printf("Enter choice: ");
    scanf("%d", &choice);

    // Select and execute the chosen algorithm
    switch (choice) {
        case 1:
            findFCFS(p, n);
            break;

        case 2:
            findSJF(p, n);
            break;

        case 3:
            findPriority(p, n);
            break;

        case 4:
            printf("Enter time quantum: ");
            scanf("%d", &quantum);

            if (quantum <= 0) {
                printf("Time quantum must be positive.\n");
                return 1;
            }

            findRoundRobin(p, n, quantum);
            break;

        default:
            printf("Invalid choice.\n");
            return 1;
    }

    // Display final scheduling results
    printResult(p, n);

    return 0;
}
